# Configure in Railway. Never place these in frontend env variables.
DATABASE_URL=postgresql://user:password@hostname/neondb?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGINS=http://127.0.0.1:5173
UPLOAD_DIR=/data/uploads
APP_ENV=production
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional Sepolia anchoring; leave unset until the contract is deployed.
SEPOLIA_RPC_URL=
LEDGER_CONTRACT_ADDRESS=
LEDGER_PRIVATE_KEY=

# Optional private development network (chain ID 1337; private RPC only)
LEDGER_NETWORK=sepolia
LEDGER_RPC_URL=
AUTO_ANCHOR=false
AUTO_VERIFY=true

# Separate document vault; do not change an existing fraud ledger network.
VAULT_NETWORK=sepolia
VAULT_SEPOLIA_RPC_URL=https://endpoints.omniatech.io/v1/eth/sepolia/public
VAULT_PRIVATE_KEY=
VAULT_CONTRACT_ADDRESS=
PINATA_JWT=
# 32 random bytes encoded as URL-safe base64; retain this key for retrieval.
VAULT_ENCRYPTION_KEY=
